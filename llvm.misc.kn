func nodeToLlvmName(node: \wreck1@StmtNode): []char
    var path: [][]char :: #[0,0]char
    while(node.kind <> %root)
        var names: [][]char :: node.name.split(".")
        do path :: [names[^names-1]] ~ path
        {"%cool_func._if2._case0._while3.inner_cooler_func"->"inner_cooler_func"}
        do node :: node.parent
    end while
    if(^path = 1) {global}
        ret "@" ~ path.join(".")
    else {local}
        ret "%" ~ path.join(".").sub(1, -1)
        {既に命名されたグローバル変数のpfx'@'が混入しており、これを'%'で置換する}
    end if
    {"%cool_func._if2._case0._while3.inner_cooler_func.hoge"みたいになる}
end func

func dropTypeSfx(value: []char, type: \wreck1@Type): []char
    if(type.sfx =& null)
        ret value
    end if
    if(value.sub(^value-^type.sfx, -1) = type.sfx)
        ret value.sub(0, ^value-^type.sfx)
    else
        do \util@crash("\{value} is supposed to have type \{type.name} but has different suffix")
        ret null
    end if
end func

func charLiteralToLlvmLiteral(literal: []char): []char
    switch(^literal)
    case 3
        ret "\{literal[1] $ int}"
    case 4
        switch(literal[2])
        case '\\'
            ret "92"
        case '\"'
            ret "34"
        case '\''
            ret "39"
        case '0'
            ret "0"
        case 'n'
            ret "10"
        default
            do \util@crash("Unknown excape sequence \{literal} has no LLVM equivalent")
        end switch
    end switch
    ret null
end func

func strLiteralToLlvmLiteral(literal: []char): []char
    var result: []char :: "c\""
    for i(1, ^literal-2)
        switch es(literal.sub(i, 2))
        case "\\\\", "\\\"", "\\'", "\\0", "\\n"
            do i :+ 1
            do result :~ @escapeSequenceToLlvmChar(es)
        default
            do result :~ literal[i].toStr()
        end switch
    end for
    ret result ~ "\""
end func

func llvmStrLiteralToSize(literal: []char): int
    {[n x i8]型でc"こういうリテラル"である場合しか考慮していない}
    var size: int :: 0
    for i(2, ^literal-2)
        if(i<^literal-2)
            switch(literal.sub(i, 2))
            case "\\\\"
                do i :+ 1
                do size :+ 8
                skip i
            end switch
        end if
        if(i<^literal-3)
            switch(literal.sub(i, 3))
            case "\\22", "\\27", "\\00", "\\0A"
                do i :+ 2
                do size :+ 8
                skip i
            end switch
        end if
        do size :+ 8 * \stx@lenUtf8(literal[i])
    end for
    ret size
end func

func escapeSequenceToLlvmChar(escapeSequence: []char): []char
    switch(escapeSequence)
    case "\\\\"
        ret "\\\\"
    case "\\\""
        ret "\\22"
    case "\\'"
        ret "\\27"
    case "\\0"
        ret "\\00"
    case "\\n"
        ret "\\0A"
    default
        do \util@crash("Unknown escape sequence \{escapeSequence} has no LLVM equivalent")
        ret null
    end switch
end func
