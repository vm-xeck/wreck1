func nodeToLlvmName(node: \wreck1@StmtNode): []char
    var path: [][]char :: #[0,0]char
    while(node.kind <> %root)
        var names: [][]char :: node.name.split(".")
        do path :: [names[^names-1]] ~ path
        {"%cool_func._if2._case0._while3.inner_cooler_func"->"inner_cooler_func"}
        do node :: node.parent
    end while
    if(^path = 1) {global}
        ret "@" ~ path.join(".")
    else {local}
        ret "%" ~ path.join(".").sub(1, -1)
        {既に命名されたグローバル変数のpfx'@'が混入しており、これを'%'で置換する}
    end if
    {"%cool_func._if2._case0._while3.inner_cooler_func.hoge"みたいになる}
end func

func dropTypeSfx(value: []char, type: \wreck1@Type): []char
    if(value.sub(^value-^type.sfx, -1) = type.sfx)
        ret value.sub(0, ^value-^type.sfx)
    else
        do \util@crash("\{value} is supposed to have type \{type.name} but has different suffix")
        ret null
    end if
end func

func charLiteralToLlvmLiteral(literal: []char): []char
    switch(^literal)
    case 3
        ret "\{literal[1] $ int}"
    case 4
        switch(literal[2])
        case '\\'
            ret "92"
        case '\"'
            ret "34"
        case '\''
            ret "39"
        case '0'
            ret "0"
        case 'n'
            ret "10"
        default
            do \util@crash("Unknown excape sequence \{literal} has no LLVM equivalent")
        end switch
    end switch
    ret null
end func

func aryLiteralToSize(literal: \wreck1@ExprNode, elemType: @Type): int
    ret ^literal.args * elemType.size
end func

func escapeSequenceToLlvmChar(escapeSequence: []char): []char
    switch(escapeSequence)
    case "\\\\"
        ret "\\\\"
    case "\\\""
        ret "\\22"
    case "\\'"
        ret "\\27"
    case "\\0"
        ret "\\00"
    case "\\n"
        ret "\\0A"
    default
        do \util@crash("Unknown escape sequence \{escapeSequence} has no LLVM equivalent")
        ret null
    end switch
end func
