        |"  %3 = alloca [3 x i8]\n  store[3 x i8] c\"%u\\00\", ptr %3\n  %4 = call i32 (ptr, ...) @printf(ptr %3, i64 %1)\n  ret i32 %4\n",
        |parent
    |)
end func

func print_float64(parent: \wreck1@StmtNode): \wreck1@StmtNode
    ret \wreck1@makeBuiltinFuncNode(
        |"print_float64",
        |\wreck1@int32(),
        |[\wreck1@makeFuncArg("%1", \wreck1@float64())],
        |"  %3 = alloca [3 x i8]\n  store[3 x i8] c\"%f\\00\", ptr %3\n  %4 = call i32 (ptr, ...) @printf(ptr %3, double %1)\n  ret i32 %4\n",
        |parent
    |)
end func

func print_bool(parent: \wreck1@StmtNode): \wreck1@StmtNode
    ret \wreck1@makeBuiltinFuncNode(
        |"print_bool",
        |\wreck1@int32(),
        |[\wreck1@makeFuncArg("%1", \wreck1@bool_())],
        |"  br i1 %1, label %print_true, label %print_false\nprint_true:\n  %true = alloca [5 x i8]\n  store [5 x i8] c\"true\\00\", ptr %true\n  %3 = call i32 (ptr, ...) @printf(ptr %true)\n  ret i32 %3\nprint_false:\n  %false = alloca [6 x i8]\n  store [6 x i8] c\"false\\00\", ptr %false\n  %4 = call i32 (ptr, ...) @printf(ptr %false)\n  ret i32 %4\n",
        |parent
    |)
end func

func print_newline(parent: \wreck1@StmtNode): \wreck1@StmtNode
    ret \wreck1@makeBuiltinFuncNode(
        |"print_newline",
        |\wreck1@int32(),
        |#[0]\wreck1@FuncArg,
        |"  %3 = alloca [2 x i8]\n  store[2 x i8] c\"\\0A\\00\", ptr %3\n  %4 = call i32 (ptr, ...) @printf(ptr %3)\n  ret i32 %4\n",
        |parent
    |)
end func
