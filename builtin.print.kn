func print_int64(parent: \wreck1@StmtNode): \wreck1@StmtNode
    ret \wreck1@makeBuiltinFuncNode(
        |"print_int64",
        |\wreck1@int32(),
        |[\wreck1@makeFuncArg("%1", \wreck1@int64())],
        |"  %3 = alloca [3 x i8]\n  store[3 x i8] c\"%d\\00\", ptr %3\n  %4 = call i32 (ptr, ...) @printf(ptr %3, i64 %1)\n  ret i32 %4\n}declare i32 @printf(ptr, ...);",
        |parent
    |)
end func

