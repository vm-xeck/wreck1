func declareFuncs(): []char
    var llvm: []char :: ""
    do llvm :~ "declare ptr @malloc(i32)\n"
    do llvm :~ "declare void @free(ptr)\n"
    do llvm :~ "declare ptr @memcpy(ptr, ptr, i32)\n"
    ret llvm
end func


func defineStructs(): []char
    var llvm: []char :: ""
    do llvm :~ "%Ary = type {i32, ptr}\n"{size in bytes and the actual pointer}
    ret llvm
end func


func malloc(result: []char, byte: []char): []char
    ret @call(result, @ptr(), "@malloc", "i32 \{byte}")
end func

func free(ptr: []char): []char
    ret @call("", @void(), "@free", "ptr \{ptr}")
end func

func memcpy(dest: []char, src: []char, byte: []char): []char
    ret @call("", @ptr(), "@memcpy", "ptr \{dest}, ptr \{src}, i32 \{byte}")
end func
