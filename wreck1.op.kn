+class Op()
    +var symbol: []char
    +var retType: @Type
    +var arity: int {項の個数}
end class


+func assign(argTypes: []@Type): @Op
    if(^argTypes<>2 | argTypes[0]<>argTypes[1])
        do @opTypeError("assign", argTypes)
    end if

    var op: @Op :: #@Op
    do op.symbol :: "<-"
    do op.retType :: argTypes[0]
    do op.arity :: 2
    ret op
end func

+func or(argTypes: []@Type): @Op
    if(^argTypes<>2 | argTypes[0]<>@bool_() | argTypes[1]<>@bool_())
        do opTypeError("or", argTypes)
    end if

    var op: @Op :: #@Op
    do op.symbol :: "|"
    do op.retType :: @bool_()
    do op.arity :: 2
    ret op
end func

+func and(argTypes: []@Type): @Op
    if(^argTypes<>2 | argTypes[0]<>@bool_() | argTypes[1]<>@bool_())
        do opTypeError("and", argTypes)
    end if

    var op: @Op :: #@Op
    do op.symbol :: "&"
    do op.retType :: @bool_()
    do op.arity :: 2
    ret op
end func

