+func cat(argTypes: []@Type): @Op
    if(^argTypes<>2 | argTypes[0]<>argTypes[1])
        do @opTypeError("cat", argTypes)
    elif(argTypes[0].name.sub(0, 2) <> "[]") {もっとましな方法ないのかよ}
        do @opTypeError("cat", argTypes)
    end if

    var op: @Op :: #@Op
    do op.symbol :: @catSymbol
    do op.retType :: argTypes[0]
    do op.arity :: 2
    ret op
end func

