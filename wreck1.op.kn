+func lt(argTypes: []@Type): @Op
    if(^argTypes<>2 | argTypes[0]<>argTypes[1])
        do @opTypeError("lt", argTypes)
    end if
    switch(argTypes[0])
    case @int8(), @int16(), @int32(), @int64(), @uint8(), @uint16(), @uint32(), @uint64(), @float32(), @float64() {OK}
    default
        do @opTypeError("lt", argTypes)
    end switch

    var op: @Op :: #@Op
    do op.symbol :: @ltSymbol
    do op.retType :: @bool_()
    do op.arity :: 2
    ret op
end func

