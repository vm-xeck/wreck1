+class Op()
    +var symbol: []char
    +var retType: @Type
    +var arity: int {項の個数}
end class


+const assignSymbol: []char :: "<-"
+const orSymbol: []char :: "|"
+const andSymbol: []char :: "&"
+const eqSymbol: []char :: "="
+const neqSymbol: []char :: "<>"
+const ltSymbol: []char :: "<"
+const leqSymbol: []char :: "<="
+const gtSymbol: []char :: ">"
+const geqSymbol: []char :: ">="
+const catSymbol: []char :: "~"
+const addSymbol: []char :: "+"
+const subSymbol: []char :: "-"
+const mulSymbol: []char :: "*"
+const divSymbol: []char :: "/"
+const remSymbol: []char :: "%"
+const negSymbol: []char :: "-"
+const notSymbol: []char :: "!"
+const lenSymbol: []char :: "^"
+const aryElemSymbol: []char :: "["


+func assign(argTypes: []@Type): @Op
    if(^argTypes<>2 | argTypes[0]<>argTypes[1])
        do @opTypeError("assign", argTypes)
    end if

    var op: @Op :: #@Op
    do op.symbol :: @assignSymbol
    do op.retType :: argTypes[0]
    do op.arity :: 2
    ret op
end func

+func or(argTypes: []@Type): @Op
    if(^argTypes<>2 | argTypes[0]<>@bool_() | argTypes[1]<>@bool_())
        do @opTypeError("or", argTypes)
    end if

    var op: @Op :: #@Op
    do op.symbol :: @orSymbol
    do op.retType :: @bool_()
    do op.arity :: 2
    ret op
end func

