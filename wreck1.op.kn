+func neg(argTypes: []@Type): @Op
    if(^argTypes <> 1)
        do opTypeError("neg", argTypes)
    end if
    switch(argTypes[0])
    case @int8(), @int16(), @int32(), @int64(), @float32(), @float64() {OK}
    default
        do opTypeError("neg", argTypes)
    end switch

    var op: @Op :: #@Op
    do op.symbol :: "-"
    do op.retType :: argTypes[0]
    do op.arity :: 1
    ret op
end func

+func not(argTypes: []@Type): @Op
    if(^argTypes<>1 | argTypes[0]<>@bool_())
        do opTypeError("not", argTypes)
    end if

    var op: @Op :: #@Op
    do op.symbol :: "!"
    do op.retType :: @bool_()
    do op.arity :: 1
    ret op
end func



func opTypeError(name: []char, argTypes: []@Type)
    var msg: []char :: "演算子の型エラー: \{name}に"
    for i(0, ^argTypes-2)
        do msg :~ argTypes[i].name ~ ", "
    end for
    do msg :~ argTypes[^argTypes-1].name ~ "を作用できません"
    do \util@crash(msg)
end func
