+func neg(argTypes: []@Type): @Op
    if(^argTypes <> 1)
        do @opTypeError("neg", argTypes)
    end if
    switch(argTypes[0])
    case @int8(), @int16(), @int32(), @int64(), @float32(), @float64() {OK}
    default
        do @opTypeError("neg", argTypes)
    end switch

    var op: @Op :: #@Op
    do op.symbol :: @negSymbol
    do op.retType :: argTypes[0]
    do op.arity :: 1
    ret op
end func

+func not(argTypes: []@Type): @Op
    if(^argTypes<>1 | argTypes[0]<>@bool_())
        do @opTypeError("not", argTypes)
    end if

    var op: @Op :: #@Op
    do op.symbol :: @notSymbol
    do op.retType :: @bool_()
    do op.arity :: 1
    ret op
end func

+func len(argTypes: []@Type): @Op
    if(^argTypes<>1 | argTypes[0].name.sub(0, 2)<>"[]")
        do @opTypeError("len", argTypes)
    end if

    var op: @Op :: #@Op
    do op.symbol :: @lenSymbol
    do op.retType :: @int64() {負の値になり得ないのに符号付き、どうなんだろう}
    do op.arity :: 1
    ret op
end func

+func aryElem(argTypes: []@Type): @Op
    if(^argTypes<>2 | argTypes[0].name.sub(0, 2)<>"[]" | argTypes[1]<>@int64())
        do @opTypeError("aryElem", argTypes)
    end if

    var op: @Op :: #@Op
    do op.symbol :: @aryElemSymbol
    do op.retType :: argTypes[0].aryElemType
    do op.arity :: 1
    ret op
end func



func opTypeError(name: []char, argTypes: []@Type)
    var msg: []char :: "演算子の型エラー: \{name}に"
    var argTypeNames: [][]char :: #[0,0]char
    for i(0, ^argTypes-1)
        do argTypeNames :~ [argTypes[i].name]
    end for
    do msg :~ argTypeNames.join(", ") ~ "を作用できません"
    do \util@crash(msg)
end func
