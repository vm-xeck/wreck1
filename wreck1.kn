+class ExprNode()
    enum ExprKind
        funcCall
        varRef
        constRef
        op
        literal
    end enum

    +var kind: ExprKind
    +var value: []char {literal}
    +var ref: @StmtNode {func-call | var-ref | const-ref}
    +var op: @Op {operator}
    +var type: @Type
    +var args: []ExprNode
    *func ctor()
        do me.args :: #[0]ExprNode
    end func
    +func depth(): int
        var d: int :: 0
        for i(0, ^me.args)
            do d :: lib@max(d, me.args[i].depth()+1)
        end for
        ret d
    end func
end class

+func makeFuncCallNode(ref: @StmtNode, args: []@ExprNode): @ExprNode
    var node: @ExprNode :: #@ExprNode
    do node.kind :: %funcCall
    do node.type :: ref.type
    do node.ref :: ref
    do node.args :: args
    ret node
end func

+func makeVarRefNode(ref: @StmtNode): @ExprNode
    var node: @ExprNode :: #@ExprNode
    do node.kind :: %varRef
    do node.type :: ref.type
    do node.ref :: ref
    ret node
end func

+func makeConstRefNode(ref: @StmtNode): @ExprNode
    var node: @ExprNode :: #@ExprNode
    do node.kind :: %constRef
    do node.type :: ref.type
    do node.ref :: ref
    ret node
end func

+func makeOpNode(op: @Op, args: []@ExprNode): @ExprNode
    var node: @ExprNode :: #@ExprNode
    do node.kind :: %op
    do node.op :: op
    do node.type :: op.retType
    do node.args :: args
    ret node
end func

+func makeLiteralNode(value: []char, type: @Type): @ExprNode
    var node: @ExprNode :: #@ExprNode
    do node.kind :: %literal
    do node.value :: value
    do node.type :: type
    ret node
end func

{
+class Entry()
    enum EntryKind
        func_
        var_
        const_
    end enum

    +var name: []char
    +var path: [][]char
    +var kind: EntryKind
    +var type: @Type
    +var argTypes: []@Type
end class

+func makeFuncEntry(name: []char, path: [][]char, type: @Type, argTypes: []@Type): @Entry
    var entry: #@Entry
    do entry.name :: name
    do entry.path :: path
    do entry.kind :: %func_
    do entry.type :: type
    do entry.argTypes :: argTypes
    ret entry
end func

+func makeVarEntry(name: []char, type: @Type, argTypes: []@Type): @Entry
    var entry: #@Entry
    do entry.name :: name
    do entry.path :: path
    do entry.kind :: %var_
    do entry.type :: type
    do entry.argTypes :: argTypes
    ret entry
end func

+func makeConstEntry(name: []char, type: @Type, argTypes: []@Type): @Entry
    var entry: #@Entry
    do entry.name :: name
    do entry.path :: path
    do entry.kind :: %const_
    do entry.type :: type
    do entry.argTypes :: argTypes
    ret entry
end func

+class Namespace()
    var entries: list<@Entry>
    *func ctor()
        do me.entries :: #list<@Entry>
    end func
    +func add(entry: @Entry)
        do me.entries.add(entry)
    end func
    +func get(name: []char, path: [][]char, isFunc: bool, existed: &bool): @Entry
        do me.entries.tail()
        while(!me.entries.term())
            var entry: @Entry :: me.entries.get()
            if(entry.name=name & entry.path=path)
                if(entry.kind=%func_ & isFunc)
                    do existed :: true
                    ret entry
                end if
                if((entry.kind=%var_ | entry.kind=%const_) & !isFunc)
                    do existed :: true
                    ret entry
                end if
            end if
            do me.entries.prev()
        end while
        if(^path <= 0)
            do existed :: false
            ret null
        else
            ret me.get(name, path.sub(0, ^path-1), isFunc)
        end if
    end func
    +func exist(name: []char, path: [][]char, isFunc: bool): bool
        var existed: bool
        do me.get(name, path, isFunc, &existed)
        ret existed
    end func
    +func typeOf(name: []char, path: [][]char, isFunc: bool): @Type
        ret me.get(name, path, isFunc, &).type
    end func
    +func isMutable(name: []char, path: [][]char): bool
        var entry: @Entry :: me.get(name, path, false, &)
        ret entry.kind = %var_
    end func
end class
}
