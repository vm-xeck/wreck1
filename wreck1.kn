+func strToType(str: []char): @Type_
    switch(str)
    case "bool"
        ret %bool_
    case "int8"
        ret %int8
    case "int16"
        ret %int16
    case "int32"
        ret %int32
    case "int64"
        ret %int64
    case "uint8"
        ret %uint8
    case "uint16"
        ret %uint16
    case "uint32"
        ret %uint32
    case "uint64"
        ret %uint64
    case "float32"
        ret %float32
    case "float64"
        ret %float64
    default
        ret %struct
    end switch
end func
+func typeToStr(type: @Type_): []char
    switch(type)
    case %bool_
        ret "bool"
    case %int8
        ret "int8"
    case %int16
        ret "int16"
    case %int32
        ret "int32"
    case %int64
        ret "int64"
    case %uint8
        ret "uint8"
    case %uint16
        ret "uint16"
    case %uint32
        ret "uint32"
    case %uint64
        ret "uint64"
    case %float32
        ret "float32"
    case %float64
        ret "float64"
    case %struct
        ret "struct"
    case %undetermined
        ret "(undetermined)"
    end switch
end func
+func isPossibleLiteral(literal: []char, type: @Type_): bool
{sfxと型の対応を確認するだけ。実質的な型推論の終焉}
{「可能なリテラルか」ではなく型の判別のみしており、本当はおかしい}
    if(literal="true" | literal="false")
        ret type = %bool_
    end if
    if(type = %int64)
        for i(0, ^literal-1)
            if(!\util@isNum(literal[i]))
                ret false
            end if
        end for
        ret true
    end if
    if(type = %float64)
        var dotCount: int :: 0
        for i(0, ^literal-1)
            if(\util@isNum(literal[i]))
            elif(literal[i] = '.')
                do dotCount :+ 1
            else
                ret false
            end if
        end for
        ret dotCount = 1
    end if
    if(^literal <= 1)
        ret false
    end if
    switch(literal.sub(^literal-2, -1))
    case "uy"
        ret type = %uint8
    case "us"
        ret type = %uint16
    case "um"
        ret type = %uint32
    end switch
    switch(literal.sub(^literal-1, -1))
    case "u"
        ret type = %uint64
    case "y"
        ret type = %int8
    case "s"
        ret type = %int16
    case "m"
        ret type = %int32
    case "f"
        ret type = %float32
    end switch
    ret false
end func
+func defaultValue(type: @Type_): []char
    switch(type)
    case %bool_
        ret "false"
    case %int8
        ret "0y"
    case %int16
        ret "0s"
    case %int32
        ret "0m"
    case %int64
        ret "0"
    case %uint8
        ret "0uy"
    case %uint16
        ret "0us"
    case %uint32
        ret "0um"
    case %uint64
        ret "0u"
    case %float32
        ret "0.0f"
    case %float64
        ret "0.0"
    default
        ret "" {TODO: struct->null | array->?(maybe [] or null) | else->???}
    end switch
end func

+func dropSfx(literal: []char): []char
    switch(literal[^literal-1])
    case 'u', 'y', 's', 'm', 'f'
        ret dropSfx(literal.sub(0, ^literal-1))
    default
        ret literal
    end switch
end func
