+class Type()
    +var name: []char
    +var defaultValue: []char
    +var sfx: []char
    +var aryElemType: Type
    +var strctElemTypes: []@Type

    +*func cmp(t: kuin@Class): int
        var type2: Type :: t $ Type
        if(me.name = type2.name)
            ret 0
        elif(me.name < type2.name)
            ret -1
        else
            ret 1
        end if
    end func
end class


+func bool_(): @Type
    var type: @Type :: #@Type
    do type.name :: "bool"
    do type.defaultValue :: "false"
    do type.sfx :: ""
    ret type
end func

+func int8(): @Type
    var type: @Type :: #@Type
    do type.name :: "int8"
    do type.defaultValue :: "0y"
    do type.sfx :: "y"
    ret type
end func

