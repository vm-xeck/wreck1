+func array(elemType: @Type): @Type
    var type: @Type :: #@Type
    do type.name :: "[]\{elemType.name}"
    do type.defaultValue :: "[]"
    do type.aryElemType :: elemType
    ret type
end func

+func struct(name: []char, elemTypes: []@Type): @Type
    var type: @Type :: #@Type
    do type.name :: name
    do type.defaultValue :: "{}"
    do type.strctElemTypes :: elemTypes
    ret type
end func
