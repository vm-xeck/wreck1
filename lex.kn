enum TokenKind
    init
    op
    ident
    numLiteral
    charLiteral
    strLiteral
    ; TODO: structLiteral
    comment
end enum

+func tokenize(code: []char): list<[]char>
    var tokens: list<[]char> :: #list<[]char>
    var tokenKind: @TokenKind :: %init
    var buf: []char :: ""

    for i(0, ^code-1)
        switch(tokenKind)
        case %init
            switch c(code[i])
            case 'A' to 'Z', 'a' to 'z'
                do tokenKind :: %ident
                do buf :: c.toStr()
            case '0' to '9'
                do tokenKind :: %numLiteral
                do buf :: c.toStr()
            case '\''
                do tokenKind :: %charLiteral
                do buf :: c.toStr()
            case '\"'
                do tokenKind :: %strLiteral
                do buf :: c.toStr()
            case '[', ']' {arrays}
                do tokens.add(c.toStr())
            case '#'
                do tokenKind :: %comment
            case ' ', '\t', '\n'
            case '(', ')', '{', '}', ',' {ktp.}
                do tokens.add(c.toStr())
                do buf :: ""
            case ':', '|', '&', '=', '<', '>', '+', '-', '*', '/', '%', '!', '~', '^'
                do tokenKind :: %op
                do buf :: c.toStr()
            default {謎}
                do \util@crash("かんたん字句解析 しっぱい...: '\{c}'")
            end switch
        case %op
            ; TODO: 可能な演算子*のprefix*かどうか判定
            switch op(buf ~ [code[i]])
            case "::", "<-", "<>", "<=", ">="
                do tokens.add(op)
                do buf :: ""
                do tokenKind :: %init
                skip i
            end switch
            do tokens.add(buf)
            do buf :: ""
            do tokenKind :: %init
            do i :- 1
        case %ident
            switch c(code[i])
            case 'A' to 'Z', 'a' to 'z', '0' to '9', '_'
                do buf :~ c.toStr()
            default
                do tokens.add(buf)
                do buf :: ""
                do tokenKind :: %init
                do i :- 1
            end switch
        case %numLiteral
            switch c(code[i])
            case 'y', 's', 'm', 'f'
                do tokens.add(buf ~ [c])
                do buf :: ""
                do tokenKind :: %init
                skip i
            end switch
            if(buf[^buf-1] = 'u')
                do tokens.add(buf)
                do buf :: ""
                do tokenKind :: %init
                do i :- 1
                skip i
            end if
            switch c(code[i])
            case '0' to '9', '.', 'u'
                do buf :~ c.toStr()
            default
                do tokens.add(buf)
                do buf :: ""
                do tokenKind :: %init
                do i :- 1
            end switch
        case %charLiteral
            if(code[i]='\'' & (buf[^buf-1]<>'\\'|buf[^buf-2]='\\'))
                do tokens.add(buf ~ [code[i]])
                do buf :: ""
                do tokenKind :: %init
            else
                do buf :~ [code[i]]
            end if
        case %strLiteral
            do buf :~ code[i].toStr()
            if(buf[^buf-1]='\"' & (buf[^buf-2]<>'\\'|buf[^buf-3]='\\'))
                do tokens.add(buf)
                do buf :: ""
                do tokenKind :: %init
            end if
        case %comment
            if(code[i] = '#')
                do tokenKind :: %init
            end if
        end switch
    end for

    if(tokenKind <> %init)
        do tokens.add(buf)
    end if
    ret tokens
end func
