+func addBuiltins(root: \wreck1@StmtNode)
    do root.stmts.add(@int8_to_uint8(root))
end func

func int8_to_uint8(parent: \wreck1@StmtNode): \wreck1@StmtNode
    ret \wreck1@makeBuiltinFuncNode(
        |"int8_to_uint8",
        |\wreck1@uint8(),
        |[\wreck1@makeFuncArg("%1", \wreck1@int8())],
        |"define i8 @int8_to_uint8(i8 %1) {\n  ret i8 %1\n}\n",{型とか直書きじゃなくて\wreck1@int8().nameにしたくない？}
        |parent
    |)
end func
